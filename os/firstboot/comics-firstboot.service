[Unit]
Description=Comic-Rechner: Erstkonfiguration per ansible-pull
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/comics/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/comics-firstboot
TimeoutStartSec=3600
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
