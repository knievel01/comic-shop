# Alle Variablen ohne Werte. Echte Datei: /etc/comics/comics.env (chmod 600), niemals committen.
# Ansible erzeugt daraus die Kubernetes-Secrets (Rolle apps).

# --- AWS / S3 ---
AWS_REGION=eu-central-1
S3_BUCKET=
# IAM-User "comics-app" (aus infra/aws, Output access_key_id / secret)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Separater, schwächerer Schlüssel nur für den Scan-Upload (PutObject auf eingang/)
SCAN_UPLOAD_AWS_ACCESS_KEY_ID=
SCAN_UPLOAD_AWS_SECRET_ACCESS_KEY=

# --- Erkennung ---
ANTHROPIC_API_KEY=
# Modell und Effort für die Erkennung (Ergebnis des Vergleichstests, docs/PREISFINDUNG.md)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# optional, nur falls der Vergleichstest (Phase 6.1) Ximilar empfiehlt
XIMILAR_API_TOKEN=

# --- Shopify ---
SHOPIFY_SHOP_DOMAIN=
# Dev-Dashboard-App (ab 2026 Standard): Client-ID und Client-Schlüssel, der Dienst holt den 24-h-Token selbst.
# SHOPIFY_ADMIN_TOKEN nur für eine ältere benutzerdefinierte App (dann CLIENT_* leer lassen). ADR-0021.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_LOCATION_ID=
# Kommagetrennte Publication-IDs (z. B. Online Store), in die neue Produkte veröffentlicht werden
SHOPIFY_PUBLICATION_IDS=

# --- n8n ---
# Separat im Passwort-Manager sichern! Ohne ihn sind alle n8n-Credentials nach einer Neuinstallation wertlos.
N8N_ENCRYPTION_KEY=
# Öffentliche Basis-URL für Webhooks (Cloudflare-Tunnel), z. B. https://hooks.example.de/
WEBHOOK_URL=

# --- Postgres (interne n8n-Datenbank) ---
POSTGRES_PASSWORD=

# --- comic-helper ---
# Shared secret between n8n and comic-helper (header X-Helper-Token)
HELPER_TOKEN=
# Public base URL of the review UI (only reachable in the LAN)
REVIEW_BASE_URL=
# Optionales Passwort für die Review-Oberfläche (HTTP Basic, Benutzername beliebig)
REVIEW_PASSWORD=

# --- Mail ---
# SMTP-Zugang wird in n8n als Credential "SMTP Comics" angelegt (nicht als Env-Variable genutzt),
# hier nur zur Dokumentation, was im Passwort-Manager liegen muss.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO_DAILY=
MAIL_TO_ALERTS=

# --- Öffentlicher Webhook-Zugang ---
CLOUDFLARE_TUNNEL_TOKEN=
